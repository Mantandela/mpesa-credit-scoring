# Copy to .env (gitignored) and fill in. Never commit .env.
# Local PostgreSQL from docker-compose.yml
POSTGRES_USER=creditscore
POSTGRES_PASSWORD=change-me
POSTGRES_DB=creditscore
POSTGRES_PORT=5432

# The app and scripts read DATABASE_URL from the environment (or from .streamlit/secrets.toml on Streamlit Cloud).
# Leave it unset to use SQLite at data/private/app.db.
# Local Docker:  postgresql+psycopg://creditscore:change-me@127.0.0.1:5432/creditscore
# Neon:          postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=

# Optional demo account passwords (otherwise generated and printed once by scripts/create_demo_users.py)
DEMO_VENDOR_PASSWORD=
DEMO_UMOJA_PASSWORD=
DEMO_TUMAINI_PASSWORD=
DEMO_ADMIN_PASSWORD=
